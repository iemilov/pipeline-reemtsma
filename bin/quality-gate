#!/usr/bin/env bash
# pipeline/bin/quality-gate — decide whether a review loop may exit, must run
# another round, or has to stop with the gate still open.
#
# This is the loop-engineering counterpart to bin/review-runtime (WHO reviews)
# and bin/runtime-autoswitch (WHERE the analysis runs): it answers WHEN the
# verify -> fix -> re-verify loop is done. Skills call this instead of
# re-deriving the arithmetic, so the exit condition is deterministic under every
# runtime — a weak local model must not be the thing that decides "good enough".
#
# Usage:
#   pipeline/bin/quality-gate --check [--file <config>]
#   pipeline/bin/quality-gate --round <n> --blockers <n> --majors <n> \
#       [--score <0-100>] [--prev-score <0-100>] [--file <config>]
#
# Configuration (customer.config.md > ## Quality Gate; both optional):
#   Quality Gate Score   minimum rubric score (0-100) a round must reach.
#                        Unset / non-numeric / `off` = advisory only: the
#                        severity gate alone decides. Default: off.
#   Review Max Rounds    hard cap on review rounds. Default: 3.
#
# A non-numeric value (including the `<!-- ... -->` placeholder an unconfigured
# template carries) is treated as unset, never as a threshold of 0 — a gate
# nobody configured must not silently pass everything, nor block everything.
#
# The severity gate is NOT configurable: open Blocker/Major findings always
# block. The score is the auditable summary on top, exactly as
# 06-code-review (Step 7) defines it. That ordering matters — a score threshold
# can only ever make the gate stricter, never waive a Blocker.
#
# Decision (printed as `decision=`, and see EXIT CODES):
#   pass      no open Blocker/Major AND (no threshold OR score >= threshold)
#   continue  the gate is open and budget remains — run another round
#   stop      the gate is open and the loop must not continue (see exit_reason)
#
# exit_reason (only on a terminal decision — pass or stop; feeds the `loop`
# object of bin/log-skill, whose vocabulary this is the source of):
#   clean             gate passed, no score threshold configured
#   score-threshold   gate passed and the configured minimum score was met
#   score-unmeasured  gate passed on severity, but a CONFIGURED score threshold
#                     could not be applied — the reviewer returned no score.
#                     Deliberately not `clean`: that word means "everything
#                     checked and green", and lending it to a measurement that
#                     did not happen is how a missing score stayed invisible
#   budget-exhausted  round budget spent with the gate still open
#   no-progress       a round failed to improve the score; stopped early
#
# `not-applicable` is the fifth vocabulary member; it is never emitted here.
# Skills pass it to bin/log-skill directly when no gate ran at all (no rubric
# was produced, nothing to verify).
#
# --prev-score enables the no-progress brake: pass the previous round's score
# and a round that fails to improve on it ends the loop instead of burning the
# remaining budget on a reviewer that has stopped converging. Omit it and the
# loop only ever stops on the round cap.
#
# Output (key=value lines on stdout):
#   decision=<pass|continue|stop>
#   exit_reason=<...>            (terminal decisions only)
#   round=<n> / max_rounds=<n>
#   score=<n|unknown> / threshold=<n|off>
#   blocking=<n>                 (blockers + majors)
#   reason=<short human-readable explanation>
#
# EXIT CODES: 0 = pass (loop may exit) · 1 = gate not satisfied (continue or
# stop — branch on `decision=`) · 2 = usage error.

set -uo pipefail

# Resolve this file through any symlinks first: `ln -s …/bin/<tool> ~/bin/<tool>`
# is a normal thing to do, and the pipeline (config, siblings, the prelude) has
# to be found next to the REAL file. `readlink -f` is not portable to the BSD
# userland this also runs on, hence the loop.
HARNESS_SELF="${BASH_SOURCE[0]}"
while [ -L "$HARNESS_SELF" ]; do
  HARNESS_LINK="$(readlink "$HARNESS_SELF")"
  case "$HARNESS_LINK" in /*) HARNESS_SELF="$HARNESS_LINK" ;; *) HARNESS_SELF="$(dirname "$HARNESS_SELF")/$HARNESS_LINK" ;; esac
done
SCRIPT_DIR="$(CDPATH= cd -P -- "$(dirname "$HARNESS_SELF")" && pwd -P)"
# usage/die/require_value/config-reading live once, in bin/lib/common.sh. A tool
# that cannot load its own prelude must not run on half its rules, and these
# tools run without `set -e`, so a failed `source` would go unnoticed.
[ -r "$SCRIPT_DIR/lib/common.sh" ] || {
  echo "${0##*/}: missing $SCRIPT_DIR/lib/common.sh — incomplete installation" >&2; exit 2; }
# shellcheck source=lib/common.sh
. "$SCRIPT_DIR/lib/common.sh"

DEFAULT_MAX_ROUNDS=3


# ---- arg parse ---------------------------------------------------------------
CHECK=0 ROUND="" BLOCKERS="" MAJORS="" SCORE="" PREV_SCORE="" CONFIG_FILE=""

KNOWN_FLAGS=" --check --round --blockers --majors --score --prev-score --file -h --help "

while [ $# -gt 0 ]; do
  case "$1" in
    --check) CHECK=1 ;;
    --round) require_value --round "${2:-}"; ROUND="$VALUE"; shift ;;
    --blockers) require_value --blockers "${2:-}"; BLOCKERS="$VALUE"; shift ;;
    --majors) require_value --majors "${2:-}"; MAJORS="$VALUE"; shift ;;
    --score) require_value --score "${2:-}"; SCORE="$VALUE"; shift ;;
    --prev-score) require_value --prev-score "${2:-}"; PREV_SCORE="$VALUE"; shift ;;
    --file) require_value --file "${2:-}"; CONFIG_FILE="$VALUE"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown argument '$1'" ;;
  esac
  shift
done

# ---- helpers -----------------------------------------------------------------
is_number() {
  case "${1:-}" in
    ''|*[!0-9.]*|.|*.*.*) return 1 ;;
    *) return 0 ;;
  esac
}

is_uint() {
  case "${1:-}" in
    ''|*[!0-9]*) return 1 ;;
    *) return 0 ;;
  esac
}

in_range() { awk -v v="$1" 'BEGIN { exit !(v >= 0 && v <= 100) }'; }

read_config() {
  # Quiet: the gate has documented defaults (no score threshold, 3 rounds), so a
  # customer without a `## Quality Gate` section — or without a config at all —
  # is a normal state, not a fault to report.
  local key="$1" val=""
  val="$(HARNESS_CONFIG_QUIET=1 HARNESS_CONFIG_FILE="$CONFIG_FILE" \
         harness_config "$key" --section "Quality Gate")"
  printf '%s' "$val"
}

# ---- resolve configuration ---------------------------------------------------
THRESHOLD_RAW="$(read_config "Quality Gate Score")"
MAX_ROUNDS_RAW="$(read_config "Review Max Rounds")"

THRESHOLD="off"
THRESHOLD_SOURCE="default"
if is_number "$THRESHOLD_RAW" && in_range "$THRESHOLD_RAW"; then
  THRESHOLD="$THRESHOLD_RAW"
  THRESHOLD_SOURCE="config"
fi

MAX_ROUNDS="$DEFAULT_MAX_ROUNDS"
MAX_ROUNDS_SOURCE="default"
if is_uint "$MAX_ROUNDS_RAW" && [ "$MAX_ROUNDS_RAW" -ge 1 ]; then
  MAX_ROUNDS="$MAX_ROUNDS_RAW"
  MAX_ROUNDS_SOURCE="config"
fi

if [ "$CHECK" -eq 1 ]; then
  echo "threshold=$THRESHOLD"
  echo "threshold_source=$THRESHOLD_SOURCE"
  echo "max_rounds=$MAX_ROUNDS"
  echo "max_rounds_source=$MAX_ROUNDS_SOURCE"
  if [ "$THRESHOLD" = "off" ]; then
    echo "reason=no score threshold configured — the severity gate (no open Blocker/Major) alone decides"
  else
    echo "reason=a round passes with no open Blocker/Major and a rubric score of at least $THRESHOLD"
  fi
  exit 0
fi

# ---- validate round inputs ---------------------------------------------------
[ -n "$ROUND" ]    || die "--round is required (or use --check)"
[ -n "$BLOCKERS" ] || die "--blockers is required"
[ -n "$MAJORS" ]   || die "--majors is required"

is_uint "$ROUND" && [ "$ROUND" -ge 1 ] || die "--round must be an integer >= 1, got: '$ROUND'"
is_uint "$BLOCKERS" || die "--blockers must be a non-negative integer, got: '$BLOCKERS'"
is_uint "$MAJORS"   || die "--majors must be a non-negative integer, got: '$MAJORS'"

for pair in "--score:$SCORE" "--prev-score:$PREV_SCORE"; do
  flag="${pair%%:*}"; val="${pair#*:}"
  [ -n "$val" ] || continue
  is_number "$val" && in_range "$val" || die "$flag must be a number between 0 and 100, got: '$val'"
done

BLOCKING=$((BLOCKERS + MAJORS))
SCORE_OUT="${SCORE:-unknown}"

emit() {
  echo "decision=$1"
  [ -n "$2" ] && echo "exit_reason=$2"
  echo "round=$ROUND"
  echo "max_rounds=$MAX_ROUNDS"
  echo "score=$SCORE_OUT"
  echo "threshold=$THRESHOLD"
  echo "blocking=$BLOCKING"
  echo "reason=$3"
}

# ---- decide ------------------------------------------------------------------
# Severity first: a score threshold may tighten the gate, never waive a Blocker.
SCORE_OK=1
SCORE_NOTE=""
if [ "$THRESHOLD" != "off" ]; then
  if [ -z "$SCORE" ]; then
    # A threshold is configured but the reviewer returned no score. Failing the
    # gate here would deadlock a loop that can never produce one; passing it
    # silently would fake a measurement. Let severity decide, and say so.
    SCORE_NOTE=" (score threshold $THRESHOLD configured but the reviewer returned no score — severity gate only)"
  elif ! awk -v s="$SCORE" -v t="$THRESHOLD" 'BEGIN { exit !(s >= t) }'; then
    SCORE_OK=0
  fi
fi

if [ "$BLOCKING" -eq 0 ] && [ "$SCORE_OK" -eq 1 ]; then
  if [ "$THRESHOLD" != "off" ] && [ -z "$SCORE" ]; then
    # The severity gate passed, but the configured score gate did not RUN.
    # `clean` is the vocabulary word for "everything checked and green", and
    # lending it to a measurement that never happened is what made the missing
    # score invisible in the log history: /pipeline-stats counted these runs as
    # clean passes. Same decision and same exit code — a different name, so the
    # two states stop sharing one.
    emit pass score-unmeasured \
      "no open Blocker/Major findings after round $ROUND — but the score threshold $THRESHOLD could not be applied: the reviewer returned no score (severity gate only)"
  elif [ "$THRESHOLD" = "off" ]; then
    emit pass clean "no open Blocker/Major findings after round $ROUND$SCORE_NOTE"
  else
    emit pass score-threshold \
      "no open Blocker/Major findings and score $SCORE >= threshold $THRESHOLD after round $ROUND"
  fi
  exit 0
fi

# The gate is open. Describe why, then decide whether another round is allowed.
if [ "$BLOCKING" -gt 0 ] && [ "$SCORE_OK" -eq 0 ]; then
  OPEN_WHY="$BLOCKING open Blocker/Major finding(s) and score $SCORE below threshold $THRESHOLD"
elif [ "$BLOCKING" -gt 0 ]; then
  OPEN_WHY="$BLOCKING open Blocker/Major finding(s)"
else
  OPEN_WHY="score $SCORE below threshold $THRESHOLD"
fi

if [ "$ROUND" -ge "$MAX_ROUNDS" ]; then
  emit stop budget-exhausted \
    "$OPEN_WHY after the final round ($ROUND/$MAX_ROUNDS) — surface what is still open, do not report the work as complete"
  exit 1
fi

# No-progress brake: only meaningful from round 2 on, and only when the caller
# supplied both scores. Equal counts as no progress — a reviewer returning the
# identical score has stopped converging, and another round is unlikely to help.
if [ -n "$PREV_SCORE" ] && [ -n "$SCORE" ] && [ "$ROUND" -ge 2 ]; then
  if ! awk -v s="$SCORE" -v p="$PREV_SCORE" 'BEGIN { exit !(s > p) }'; then
    emit stop no-progress \
      "$OPEN_WHY, and round $ROUND did not improve on the previous score ($SCORE vs $PREV_SCORE) — stopping early instead of spending the remaining budget"
    exit 1
  fi
fi

emit continue "" "$OPEN_WHY — address it and re-run the review (round $((ROUND + 1))/$MAX_ROUNDS)"
exit 1
