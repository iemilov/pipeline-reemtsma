#!/usr/bin/env bash
# config — read a single value from the active customer's configuration.
#
# Usage:
#   config "<Key>"              value of <Key> from customer.config.md (first matching table row)
#   config --stack "<Key>"      value of <Key> from stack.config.md
#   config --customer-dir       absolute path of the active customer folder (symlink target of customer.config.md)
#   config --short-name         Short Name from customer.config.md
#
# Exit codes: 0 found · 1 not found or placeholder · 2 usage error.
# A value that still looks like a template placeholder (<...>) is reported as not found.

SCRIPT_DIR="$(CDPATH= cd -P -- "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
. "$SCRIPT_DIR/lib/common.sh"

emit() {
  case "$1" in ""|"<"*">"*) return 1 ;; esac
  printf '%s\n' "$1"
}

case "${1:-}" in
  -h|--help|"") usage; exit 2 ;;
  --customer-dir)
    link="$HARNESS_PIPELINE_DIR/customer.config.md"
    if [ -L "$link" ]; then
      target="$(readlink "$link")"
      case "$target" in /*) dir="$(dirname "$target")" ;; *) dir="$HARNESS_PIPELINE_DIR/$(dirname "$target")" ;; esac
      emit "$(CDPATH= cd -P -- "$dir" && pwd -P)"
    else
      sn="$(config_value "Short Name" | tr '[:upper:]' '[:lower:]')"
      [ -n "$sn" ] && [ -d "$HARNESS_PIPELINE_DIR/customers/$sn" ] && emit "$HARNESS_PIPELINE_DIR/customers/$sn"
    fi ;;
  --short-name) emit "$(config_value "Short Name")" ;;
  --stack) [ -n "${2:-}" ] || die "--stack requires a key"; emit "$(config_value "$2" "$HARNESS_PIPELINE_DIR/stack.config.md")" ;;
  --*) die "unknown option '$1'" ;;
  *) emit "$(config_value "$1")" ;;
esac
